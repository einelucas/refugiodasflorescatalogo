# ── Neon ──
# DATABASE_URL: string POOLED (o host contém "-pooler").
# Sem o pooler, funções serverless estouram o limite de conexões.
DATABASE_URL="postgresql://user:senha@ep-xxx-pooler.sa-east-1.aws.neon.tech/refugio?sslmode=require"
# DIRECT_URL: string DIRETA (sem -pooler). Usada só nas migrações.
DIRECT_URL="postgresql://user:senha@ep-xxx.sa-east-1.aws.neon.tech/refugio?sslmode=require"

# ── Frenet ──
FRENET_TOKEN="seu-token-da-frenet"
CEP_ORIGEM="79800000"

# ── NextAuth ──
# Gere com: openssl rand -base64 32
NEXTAUTH_SECRET="troque-isto"
NEXTAUTH_URL="http://localhost:3000"

# ── Vercel Blob (upload de fotos) ──
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxx"

# ── Loja ──
WHATSAPP_LOJA="556796072932"

# ── Seed: cria o primeiro login do painel ──
ADMIN_EMAIL="cliente@exemplo.com"
ADMIN_SENHA="troque-esta-senha"
